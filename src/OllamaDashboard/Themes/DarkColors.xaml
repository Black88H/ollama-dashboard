<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==============================================================
         Dark theme design tokens.
         ============================================================== -->

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="SurfaceColor">#252526</Color>
    <Color x:Key="SurfaceAltColor">#2D2D2D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#D4D4D4</Color>
    <Color x:Key="TextSecondaryColor">#9D9D9D</Color>
    <Color x:Key="TextTertiaryColor">#6D6D6D</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#3E3E3E</Color>
    <Color x:Key="BorderStrongColor">#525252</Color>

    <!-- Accent (same warm coral) -->
    <Color x:Key="AccentColor">#D97757</Color>
    <Color x:Key="AccentHoverColor">#E8896A</Color>
    <Color x:Key="AccentSubtleColor">#3A2018</Color>

    <!-- State -->
    <Color x:Key="SuccessColor">#4EC994</Color>
    <Color x:Key="SuccessSubtleColor">#0D2820</Color>
    <Color x:Key="WarningColor">#D4A017</Color>
    <Color x:Key="WarningSubtleColor">#2A2010</Color>
    <Color x:Key="ErrorColor">#F48771</Color>
    <Color x:Key="ErrorSubtleColor">#3A1010</Color>

    <!-- Chat bubbles -->
    <Color x:Key="UserBubbleColor">#2A2A2A</Color>
    <Color x:Key="AssistantBubbleColor">#252526</Color>

    <!-- ==============================================================
         Brushes
         ============================================================== -->

    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush"     Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"     Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush"     Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush"    Color="{StaticResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush"    Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="ErrorBrush"            Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush"      Color="{StaticResource ErrorSubtleColor}" />

    <SolidColorBrush x:Key="UserBubbleBrush"       Color="{StaticResource UserBubbleColor}" />
    <SolidColorBrush x:Key="AssistantBubbleBrush"  Color="{StaticResource AssistantBubbleColor}" />

    <!-- Shared values (identical to light theme) -->
    <sys:Double x:Key="RadiusSm">6</sys:Double>
    <sys:Double x:Key="RadiusMd">8</sys:Double>
    <sys:Double x:Key="RadiusLg">12</sys:Double>
    <sys:Double x:Key="RadiusFull">999</sys:Double>

    <CornerRadius x:Key="CornerSm">6</CornerRadius>
    <CornerRadius x:Key="CornerMd">8</CornerRadius>
    <CornerRadius x:Key="CornerLg">12</CornerRadius>

    <FontFamily x:Key="FontSans">Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, monospace</FontFamily>

</ResourceDictionary>
