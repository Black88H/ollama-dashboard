<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==============================================================
         Light theme design tokens. Change values here to reskin app.
         ============================================================== -->

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F7F7F8</Color>
    <Color x:Key="SurfaceAltColor">#EFEFEF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5D5D5D</Color>
    <Color x:Key="TextTertiaryColor">#9A9A9A</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="BorderStrongColor">#CFCFCF</Color>

    <!-- Accent (Claude-inspired warm orange-coral — tweak freely) -->
    <Color x:Key="AccentColor">#D97757</Color>
    <Color x:Key="AccentHoverColor">#C26649</Color>
    <Color x:Key="AccentSubtleColor">#FAECE7</Color>

    <!-- State -->
    <Color x:Key="SuccessColor">#1D9E75</Color>
    <Color x:Key="SuccessSubtleColor">#E1F5EE</Color>
    <Color x:Key="WarningColor">#BA7517</Color>
    <Color x:Key="WarningSubtleColor">#FAEEDA</Color>
    <Color x:Key="ErrorColor">#E24B4A</Color>
    <Color x:Key="ErrorSubtleColor">#FCEBEB</Color>

    <!-- Chat bubbles -->
    <Color x:Key="UserBubbleColor">#F0F0F0</Color>
    <Color x:Key="AssistantBubbleColor">#FFFFFF</Color>

    <!-- ==============================================================
         Brushes (the things controls actually bind to).
         ============================================================== -->

    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush"     Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"     Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush"     Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush"    Color="{StaticResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush"    Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="ErrorBrush"            Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush"      Color="{StaticResource ErrorSubtleColor}" />

    <SolidColorBrush x:Key="UserBubbleBrush"       Color="{StaticResource UserBubbleColor}" />
    <SolidColorBrush x:Key="AssistantBubbleBrush"  Color="{StaticResource AssistantBubbleColor}" />

    <!-- Shared values -->
    <sys:Double x:Key="RadiusSm">6</sys:Double>
    <sys:Double x:Key="RadiusMd">8</sys:Double>
    <sys:Double x:Key="RadiusLg">12</sys:Double>
    <sys:Double x:Key="RadiusFull">999</sys:Double>

    <CornerRadius x:Key="CornerSm">6</CornerRadius>
    <CornerRadius x:Key="CornerMd">8</CornerRadius>
    <CornerRadius x:Key="CornerLg">12</CornerRadius>

    <FontFamily x:Key="FontSans">Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, monospace</FontFamily>

</ResourceDictionary>
