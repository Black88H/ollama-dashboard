{
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "llama3:latest",
    "TimeoutSeconds": 300
  },
  "Update": {
    "GitHubOwner": "yourusername",
    "GitHubRepo": "ollama-dashboard",
    "CheckOnStartup": true,
    "CheckIntervalHours": 24,
    "IncludePrereleases": false
  },
  "Logging": {
    "LogDirectory": "logs",
    "RetainedFileCountLimit": 14
  }
}
