<UserControl x:Class="OllamaDashboard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OllamaDashboard.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,24" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Einstellungen" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="Verwalte Ollama-Verbindung, Modelle und Updates"
                           Style="{StaticResource BodyMuted}" Margin="0,4,0,24" />

                <!-- ============ Ollama ============ -->
                <TextBlock Text="Ollama-Verbindung" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Base URL" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Modell" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableModels}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                            <Button Grid.Column="1" Content="Verbindung testen"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestConnectionCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="12" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Temperatur" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Value="{Binding Temperature, Mode=TwoWay}"
                                            Minimum="0" Maximum="2"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Temperature, StringFormat={}{0:0.00}}"
                                               FontSize="13" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Kontextfenster (Tokens)" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ContextWindow, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Updates ============ -->
                <TextBlock Text="Updates" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentVersion, StringFormat='Aktuelle Version: v{0}'}"
                                           FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="{Binding UpdateStatus}"
                                           Style="{StaticResource BodyMuted}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Jetzt installieren"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InstallUpdateCommand}"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding LastUpdateResult.UpdateAvailable,
                                                     Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Nach Updates suchen"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CheckUpdatesCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Download progress -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DownloadStage}" Style="{StaticResource BodyMuted}" />
                            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Release notes -->
                        <Border Margin="0,14,0,0" Padding="12"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="{StaticResource CornerMd}"
                                Visibility="{Binding LastUpdateResult.ReleaseNotes,
                                             Converter={StaticResource NullToBool},
                                             ConverterParameter=toVis}">
                            <StackPanel>
                                <TextBlock Text="{Binding LastUpdateResult.LatestVersion, StringFormat='Release Notes — v{0}'}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding LastUpdateResult.ReleaseNotes}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- GitHub repo config -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="GitHub Owner" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="GitHub Repo" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Beim Start nach Updates suchen"
                                  IsChecked="{Binding CheckUpdatesOnStartup}"
                                  Margin="0,14,0,0" />
                        <CheckBox Content="Pre-Releases einbeziehen"
                                  IsChecked="{Binding IncludePrereleases}"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Save -->
                <Button Content="Einstellungen speichern"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,24" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
