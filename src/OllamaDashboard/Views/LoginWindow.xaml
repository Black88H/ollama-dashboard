<Window x:Class="OllamaDashboard.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaDashboard.ViewModels"
        mc:Ignorable="d"
        Title="StudyCoach AI — Anmeldung"
        Width="420" Height="560"
        MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontSans}"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">

    <Grid Margin="36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo + Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="StudyCoach AI"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Gib dein Master-Passwort ein, um fortzufahren." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                <Setter Property="Text" Value="Willkommen! Lege dein Master-Passwort fest. Es verschlüsselt alle deine Daten." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Display name (first-run only) -->
            <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,16">
                <TextBlock Text="Dein Name" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Password -->
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Master-Passwort" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                <Setter Property="Text" Value="Master-Passwort (min. 8 Zeichen)" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <PasswordBox x:Name="PwdBox" Margin="0,0,0,12" />

            <!-- Confirm password (first-run only) -->
            <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Text="Passwort bestätigen" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PwdConfirmBox" />
            </StackPanel>

            <!-- Error -->
            <Border Background="{StaticResource ErrorSubtleBrush}"
                    CornerRadius="{StaticResource CornerMd}"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToBool},
                                         ConverterParameter=toVis}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Busy indicator -->
            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{StaticResource BodyMuted}" FontSize="12" Margin="0,0,0,6" />
                <ProgressBar IsIndeterminate="True" Height="3" />
            </StackPanel>

            <!-- Submit button -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding SubmitCommand}"
                    IsDefault="True"
                    HorizontalAlignment="Stretch">
                <Button.Content>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Entsperren" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                        <Setter Property="Text" Value="Einrichten und starten" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.Content>
            </Button>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="Alle Daten werden lokal mit AES-256 (SQLCipher) verschlüsselt."
                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</Window>
