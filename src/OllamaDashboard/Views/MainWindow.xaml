<Window x:Class="OllamaDashboard.Views.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaDashboard.ViewModels"
        xmlns:views="clr-namespace:OllamaDashboard.Views"
        mc:Ignorable="d"
        Title="Ollama Dashboard"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontSans}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =====================  SIDEBAR  ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,18">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Ollama Dashboard"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Chat"
                            Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChatActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="PDF Chat" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="ScriptExtractor"
                            Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScriptExtractorActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2 L14 8 L20 8 M9 15 L15 15"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Skript-Extraktor" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 8 A4 4 0 1 1 12 16 A4 4 0 1 1 12 8"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Einstellungen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="2" />

                <!-- Active-model picker (click to open popup) -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource BodyMuted}"
                               Margin="4,0,4,6" TextWrapping="Wrap" />
                    <Button x:Name="ModelPickerButton"
                            Command="{Binding ToggleModelPopupCommand}" Padding="12,10"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource CornerMd}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Aktives Modell" Style="{StaticResource BodyMuted}" />
                                <TextBlock Text="{Binding ActiveModel}" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Path Grid.Column="1" Data="M6 9 L12 15 L18 9"
                                  Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                                  Width="12" Height="12" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Popup with all installed models -->
                    <Popup IsOpen="{Binding IsModelPopupOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ModelPickerButton}"
                           Placement="Top"
                           VerticalOffset="-6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerLg}"
                                Padding="8" MinWidth="260" MaxHeight="360">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.12"
                                                  ShadowDepth="2" Color="#000000" />
                            </Border.Effect>
                            <DockPanel>
                                <!-- Header -->
                                <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                                    <TextBlock Text="Installierte Modelle"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Aktualisieren"
                                            Command="{Binding RefreshModelsCommand}"
                                            Style="{StaticResource NavButton}"
                                            Padding="8,4" FontSize="11"
                                            HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Empty state -->
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="Keine Modelle gefunden. Prüfe, ob Ollama läuft."
                                           Margin="8,4" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableModels.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Model list -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectModelCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"
                                                        Style="{StaticResource NavButton}"
                                                        Padding="10,8" Margin="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}">
                                                                <Run Text="{Binding Details.ParameterSize, Mode=OneWay, FallbackValue=''}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToSize}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- Check mark if active -->
                                                        <Path Grid.Column="1"
                                                              Data="M5 12 L10 17 L20 7"
                                                              Stroke="{StaticResource SuccessBrush}"
                                                              StrokeThickness="2"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource StringEquals}">
                                                                                    <Binding Path="Name" />
                                                                                    <Binding Path="DataContext.ActiveModel"
                                                                                            RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =====================  MAIN CONTENT  ===================== -->
        <Grid Grid.Column="1">
            <views:ChatView DataContext="{Binding Chat}"
                            Visibility="{Binding DataContext.IsChatActive,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}" />
            <views:ScriptExtractorView DataContext="{Binding ScriptExtractor}"
                            Visibility="{Binding DataContext.IsScriptExtractorActive,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}" />
            <views:SettingsView DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.IsSettingsActive,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
