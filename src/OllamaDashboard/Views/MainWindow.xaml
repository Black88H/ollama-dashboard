<Window x:Class="OllamaDashboard.Views.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaDashboard.ViewModels"
        xmlns:views="clr-namespace:OllamaDashboard.Views"
        mc:Ignorable="d"
        Title="StudyCoach AI"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontSans}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Auto so we can animate the Border width -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════  SIDEBAR  ═══════════════════════════ -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Width="240"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">

            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Brand + toggle -->
                    <RowDefinition Height="Auto" />  <!-- Nav -->
                    <RowDefinition Height="*"    />  <!-- Spacer -->
                    <RowDefinition Height="Auto" />  <!-- Model picker -->
                </Grid.RowDefinitions>

                <!-- Brand row + hamburger toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo / title — hidden when collapsed -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Visibility="{Binding IsSidebarExpanded,
                                             Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="4,0,8,0" />
                        <TextBlock Text="StudyCoach AI"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Hamburger toggle -->
                    <Button Grid.Column="1"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource NavButton}"
                            Padding="8" ToolTip="Seitenleiste ein-/ausklappen">
                        <Path Data="M3 6 L21 6 M3 12 L21 12 M3 18 L21 18"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                              Width="16" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <!-- Dashboard -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"
                            Margin="0,0,0,2" Padding="12,10" ToolTip="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3 9L12 2L21 9V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9z"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <!-- PDF Chat -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Chat"
                            Margin="0,0,0,2" Padding="12,10" ToolTip="PDF Chat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChatActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="PDF Chat" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <!-- Skript-Extraktor -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="ScriptExtractor"
                            Margin="0,0,0,2" Padding="12,10" ToolTip="Skript-Extraktor">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScriptExtractorActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2 L14 8 L20 8 M9 15 L15 15"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="Skript-Extraktor" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <!-- Einstellungen -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                            Padding="12,10" ToolTip="Einstellungen">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Tag" Value="selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 8 A4 4 0 1 1 12 16 A4 4 0 1 1 12 8"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="Einstellungen" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="2" />

                <!-- Active-model picker (visible only when expanded) -->
                <StackPanel Grid.Row="3"
                            Visibility="{Binding IsSidebarExpanded,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource BodyMuted}"
                               Margin="4,0,4,6" TextWrapping="Wrap" />
                    <Button x:Name="ModelPickerButton"
                            Command="{Binding ToggleModelPopupCommand}" Padding="12,10"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource CornerMd}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Aktives Modell" Style="{StaticResource BodyMuted}" />
                                <TextBlock Text="{Binding ActiveModel}" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Path Grid.Column="1" Data="M6 9 L12 15 L18 9"
                                  Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Popup IsOpen="{Binding IsModelPopupOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ModelPickerButton}"
                           Placement="Top" VerticalOffset="-6"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerLg}"
                                Padding="8" MinWidth="220" MaxHeight="360">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.12"
                                                  ShadowDepth="2" Color="#000000" />
                            </Border.Effect>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                                    <TextBlock Text="Installierte Modelle"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Aktualisieren"
                                            Command="{Binding RefreshModelsCommand}"
                                            Style="{StaticResource NavButton}"
                                            Padding="8,4" FontSize="11"
                                            HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="Keine Modelle gefunden. Prüfe, ob Ollama läuft."
                                           Margin="8,4" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableModels.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectModelCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"
                                                        Style="{StaticResource NavButton}"
                                                        Padding="10,8" Margin="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}">
                                                                <Run Text="{Binding Details.ParameterSize, Mode=OneWay, FallbackValue=''}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource BytesToSize}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Path Grid.Column="1"
                                                              Data="M5 12 L10 17 L20 7"
                                                              Stroke="{StaticResource SuccessBrush}"
                                                              StrokeThickness="2"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource StringEquals}">
                                                                                    <Binding Path="Name" />
                                                                                    <Binding Path="DataContext.ActiveModel"
                                                                                            RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════  CONTENT  ═══════════════════════════ -->
        <Grid Grid.Column="1">
            <views:DashboardView DataContext="{Binding Dashboard}"
                                 Visibility="{Binding IsDashboardActive,
                                              Converter={StaticResource BoolToVisibility}}" />
            <views:ChatView DataContext="{Binding Chat}"
                            Visibility="{Binding IsChatActive,
                                         Converter={StaticResource BoolToVisibility}}" />
            <views:ScriptExtractorView DataContext="{Binding ScriptExtractor}"
                                       Visibility="{Binding IsScriptExtractorActive,
                                                    Converter={StaticResource BoolToVisibility}}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding IsSettingsActive,
                                             Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
