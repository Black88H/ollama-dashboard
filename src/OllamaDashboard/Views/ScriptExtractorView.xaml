<UserControl x:Class="OllamaDashboard.Views.ScriptExtractorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OllamaDashboard.ViewModels"
             mc:Ignorable="d"
             AllowDrop="True"
             Background="{StaticResource BackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScriptExtractorViewModel}"
             d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />   <!-- Row 1: PDF drop zone -->
                <RowDefinition Height="Auto" />   <!-- Row 2: Advanced options (expander) -->
                <RowDefinition Height="Auto" />   <!-- Row 3: Detail slider + buttons -->
                <RowDefinition Height="Auto" />   <!-- Row 4: Progress bar (visible when busy) -->
                <RowDefinition Height="Auto" />   <!-- Row 5: Model recommendation banner -->
                <RowDefinition Height="*"    />   <!-- Row 6: Result preview -->
                <RowDefinition Height="Auto" />   <!-- Row 7: Export row -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 0 · Header                                                  -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Skript-Extraktor" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="Extrahiere prüfungsrelevanten Stoff aus deinem Skriptum"
                           Style="{StaticResource BodyMuted}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 1 · PDF drop zone                                           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" x:Name="DropZone"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}"
                    Padding="12,10" Margin="0,0,0,8"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPdf}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <Button Content="PDF auswählen"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PickPdfCommand}"
                                FontSize="12" Padding="10,5"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Loaded state -->
                    <Grid Visibility="{Binding HasPdf, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LoadedPdf.FileName}"
                                       FontSize="13" FontWeight="Medium" />
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource BodyMuted}" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Entfernen"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="12" Padding="8,4"
                                Command="{Binding ClearPdfCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 2 · Advanced Options (collapsible)                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Toggle header -->
                    <Button Command="{Binding ToggleAdvancedCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <TextBlock Text="Erweiterte Optionen"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Active badges -->
                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="{Binding HasFocusTopics,
                                                     Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Fokus aktiv" FontSize="10" Foreground="White" />
                                </Border>
                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="{Binding HasReferencePdf,
                                                     Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Stil aktiv" FontSize="10" Foreground="White" />
                                </Border>
                                <Path Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.5"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M2 5 L6 9 L10 5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                    <Setter Property="Data" Value="M2 9 L6 5 L10 9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Expandable content -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Fokus-Themen -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Fokus-Themen" FontSize="11" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,5"
                                   TextWrapping="Wrap" FontSize="11">
                            Komma- oder semikolongetrennte Themen — höheres Gewicht im Budget.
                        </TextBlock>
                        <TextBox Text="{Binding FocusTopics, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="8,5"
                                 TextWrapping="Wrap" AcceptsReturn="False" />

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="0,12,0,10" />

                        <!-- Stil-Referenz -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Stil-Referenz (optional)" FontSize="11" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,6"
                                   TextWrapping="Wrap" FontSize="11">
                            Lade ein Dokument, dessen Struktur als Vorlage übernommen wird.
                        </TextBlock>

                        <Border x:Name="RefDropZone"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="10,8"
                                AllowDrop="True"
                                DragOver="RefDropZone_DragOver"
                                Drop="RefDropZone_Drop">
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReferencePdf}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Referenz-PDF ablegen oder "
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Button Content="auswählen"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PickReferencePdfCommand}"
                                            FontSize="12" Padding="8,4"
                                            Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Loaded state -->
                                <Grid Visibility="{Binding HasReferencePdf,
                                                  Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ReferencePdfName}"
                                                   FontSize="12" FontWeight="Medium" />
                                        <TextBlock Text="Stil-Analyse aktiv"
                                                   Style="{StaticResource BodyMuted}" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Entfernen"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="12" Padding="8,4"
                                            Command="{Binding ClearReferencePdfCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 3 · Detail slider + action buttons                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                    Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Slider section -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Grid>
                            <TextBlock Text="Detailgrad" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DetailLevelLabel}"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="11"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding DetailLevel, Mode=TwoWay}"
                                Minimum="1" Maximum="5"
                                TickFrequency="1" TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True"
                                Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Abbrechen"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                FontSize="12" Padding="10,6"
                                Margin="0,0,6,0"
                                Visibility="{Binding IsBusy,
                                             Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Extrahieren"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExtractCommand}"
                                FontSize="12" Padding="10,6"
                                Visibility="{Binding IsBusy,
                                             Converter={StaticResource InverseBool},
                                             ConverterParameter=toVis}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 4 · Progress bar (visible while busy)                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding ExtractionStatusLabel}"
                               Style="{StaticResource BodyMuted}" FontSize="11" />
                    <TextBlock HorizontalAlignment="Right" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding ExtractionProgress, StringFormat={}{0:F0}}" /><Run Text=" %" />
                    </TextBlock>
                </Grid>
                <ProgressBar Style="{StaticResource AnimatedProgressBar}"
                             Value="{Binding ExtractionProgress}"
                             Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="4" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 5 · Model recommendation banner                             -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="5" Margin="0,0,0,8"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}"
                    Padding="12,8"
                    Visibility="{Binding HasModelRecommendation,
                                 Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ModelRecommendation}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 6 · Result preview                                           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="6" Style="{StaticResource Card}"
                    Padding="0" MinHeight="200" Margin="0,0,0,0">
                <Grid>
                    <!-- Empty placeholder -->
                    <TextBlock Text="Die Zusammenfassung erscheint hier nach der Extraktion."
                               Style="{StaticResource BodyMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="20" FontSize="12"
                               Visibility="{Binding HasResult,
                                            Converter={StaticResource InverseBool},
                                            ConverterParameter=toVis}" />

                    <!-- Result text -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="16,12"
                                  Visibility="{Binding HasResult,
                                               Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding ResultPreview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Row 7 · Export row                                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="7" Margin="0,10,0,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LastGeneratedPdfPath, StringFormat='Exportiert: {0}'}"
                           Style="{StaticResource BodyMuted}" FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="PDF öffnen"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenLastPdfCommand}"
                            FontSize="12" Padding="10,5"
                            Margin="0,0,6,0" />
                    <Button Content="Als PDF speichern"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportPdfCommand}"
                            FontSize="12" Padding="10,5" />
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
